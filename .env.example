# Postgres (production) — set one of these:
DATABASE_URL="postgresql://hercycle:hercycle@localhost:5432/hercycle?schema=public"
# Dev fallback (SQLite, zero-setup). Prisma schema uses postgresql; for quick local dev
# temporarily change provider to sqlite (see DATABASE.md) or run docker-compose.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-32-char-random-secret"
# AI provider abstraction — leave empty to use built-in safe fallback responder.
# AI_PROVIDER="openai" | "anthropic" | "gemini" | "mock"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Email (password reset + reminders). Leave empty in dev — links are logged to console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="HerCycle AI <no-reply@hercycle.ai>"
# Storage (S3-compatible for Health Vault). Dev falls back to local ./uploads (gitignored).
S3_ENDPOINT=""
S3_BUCKET="hercycle-vault"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
APP_BASE_URL="http://localhost:3000"
DEMO_SEED="true"
